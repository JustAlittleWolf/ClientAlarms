{
  "schemaVersion": 1,
  "id": "clientalarms",
  "version": "${version}",
  "name": "Client Alarms",
  "description": "Use timers, alarms and a stopwatch fully client side",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "issues": "https://github.com/JustAlittleWolf/ClientAlarms/issues/",
    "sources": "https://github.com/JustAlittleWolf/ClientAlarms/"
  },
  "license": "MIT",
  "icon": "assets/clientalarms/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.wolfii.clientalarms.client.ClientAlarmsClient"
    ],
    "modmenu": [
      "me.wolfii.clientalarms.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "clientalarms.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.9.0"
